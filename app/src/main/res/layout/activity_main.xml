<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/captureFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <HorizontalScrollView
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnFlash" style="@style/TopBarButton" android:text="⚡ Off" />
            <TextView android:id="@+id/btnMic" style="@style/TopBarButton" android:text="🎤 On" />
            <TextView android:id="@+id/btnLocation" style="@style/TopBarButton" android:text="📍 Place" />
            <TextView android:id="@+id/btnBattery" style="@style/TopBarButton" android:text="🔋" />
            <TextView android:id="@+id/btnSettings" style="@style/TopBarButton" android:text="⚙ Effects" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/recTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textColor="#FF5252"
        android:textStyle="bold"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SeekBar
        android:id="@+id/zoomSlider"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:max="100"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/controlsBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/controlsBar"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#55000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnGallery"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/round_dark"
            android:gravity="center"
            android:text="🖼"
            android:textSize="22sp"
            android:contentDescription="Open last capture" />

        <Button
            android:id="@+id/btnCapturePhoto"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="28dp"
            android:background="@drawable/shutter_photo"
            app:backgroundTint="@null"
            android:contentDescription="Take photo" />

        <Button
            android:id="@+id/btnRecordVideo"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/shutter_video"
            app:backgroundTint="@null"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:contentDescription="Record video" />

        <TextView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/round_dark"
            android:gravity="center"
            android:text="🔄"
            android:textSize="22sp"
            android:contentDescription="Switch camera" />
    </LinearLayout>

    <View
        android:id="@+id/dimOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E6000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dimHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Battery saver on — double-tap to exit"
        android:textColor="#AAFFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
